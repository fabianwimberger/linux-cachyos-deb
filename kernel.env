# Build inputs. Bump CACHY_TAG and CACHY_SHA256 together.

KERNEL_VERSION=7.2.8
CACHY_TAG=cachyos-7.2.8-1
CACHY_SHA256=f848df42bd4ac31a4918188c6723660d3c6dd7591b63a6419123dcbc23ecf328

# Debian revision; bump when the config changes but the kernel does not.
# Resets to 1 on every KERNEL_VERSION bump.
PKGREL=1

# Each entry needs a config/fragments/<flavor>.conf.
FLAVORS="x64v4 x64v3 znver4"

# distro = Ubuntu's clang (what /usr/bin/clang points at on targets); a number
# = that apt.llvm.org release. DKMS invokes bare /usr/bin/clang, so a number
# requires clients to put that clang first in PATH.
LLVM_VERSION=distro

# AutoFDO profile, relative to the repo root. Absent = instrumented build with
# no profile. Gitignored (large binary, not published).
AUTOFDO_PROFILE=profiles/vmlinux.afdo

# The profile release builds apply, by content hash, from the private profiles
# repo — like CACHY_SHA256, so a tag always rebuilds with the same profile.
# scripts/profile-upload.sh prints the value to paste here.
# AUTOFDO_PROFILE_SHA256_<flavor> overrides it for one flavor, for a profile
# recorded on that flavor's own kernel.
AUTOFDO_PROFILE_SHA256=c012651113b33d964df9fa04bcee9e30dd6003a1f393438bf3d75a8abc22bde1

# GitHub repo (owner/name) that holds the profiles; point a fork at its own.
AUTOFDO_PROFILES_REPO=fabianwimberger/linux-cachyos-deb-profiles

UBUNTU_SERIES=26.04
UBUNTU_BASE_CONFIG=config/base/ubuntu-26.04-amd64.config

# Package Maintainer field. Override before publishing.
MAINTAINER="linux-cachyos-deb <noreply@users.noreply.github.com>"

# gpg fingerprint of the key make sign uses. Assigned, not set, so the release
# workflow's exported value still wins.
: "${REPO_SIGN_KEY:=8378F57B00D6FA1F412989C7501F5C5DF11B0753}"