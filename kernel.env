# Build inputs. Bump CACHY_TAG and CACHY_SHA256 together.

KERNEL_VERSION=7.2.0
CACHY_TAG=cachyos-7.2.0-1
CACHY_SHA256=c0e49ef864fe102ff524bfb5378017546770f7ce6bcbb8cb196ae1be337c390f

# Debian revision. Bump when the config changes but the kernel does not.
PKGREL=4

# Each flavor needs config/fragments/<flavor>.conf.
FLAVORS="x64v4 x64v3 znver4"

# A number installs that release from apt.llvm.org; "distro" uses the clang in
# Ubuntu's archive. DKMS invokes bare /usr/bin/clang on the target, so a number
# here requires those clients to put the matching clang first in PATH.
LLVM_VERSION=distro

# AutoFDO profile. Relative to the repository root; unset or absent means the
# kernel is built with AutoFDO instrumentation but no profile applied, which is
# the state a profile is collected from. Deliberately gitignored: it is a large
# binary and is not published.
AUTOFDO_PROFILE=profiles/vmlinux.afdo

UBUNTU_SERIES=26.04
UBUNTU_BASE_CONFIG=config/base/ubuntu-26.04-amd64.config

# Package maintainer field. Override before publishing.
MAINTAINER="linux-cachyos-deb <noreply@users.noreply.github.com>"

# Repository signing key, as a gpg fingerprint. Only the public half is named
# here. Assigned rather than set, so the release workflow's exported value —
# the fingerprint of the key it imports from the secret — still wins.
: "${REPO_SIGN_KEY:=8378F57B00D6FA1F412989C7501F5C5DF11B0753}"
